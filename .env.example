# Copy to .env (chmod 600). Never commit .env.

# --- model ---
# Anthropic API key (console.anthropic.com). If unset, the `claude` CLI
# (Claude Code, logged in) is used instead.
ANTHROPIC_API_KEY=
RUNNER_CLAUDE_MODEL=claude-opus-5-5
RUNNER_EFFORT=medium

# --- applying ---
RUNNER_HEADLESS=1
JOB_DAILY_CAP=10
# skip postings whose stated pay tops out at or below this (USD/year)
RUNNER_MIN_PAY=100000
# 1 = still apply when a posting states no pay
RUNNER_ALLOW_UNKNOWN_PAY=1

# --- discovery ---
RUNNER_DISCOVER_MAX=60
RUNNER_MIN_SCORE=40
# 1 = jobs that pass screening are approved for applying automatically;
# 0 = you approve them yourself with `auto_apply.py review/approve`
RUNNER_AUTO_APPROVE_DISCOVERED=0

# --- Workday sign-in / account creation (optional) ---
# One login reused across employers' Workday sites.
ATS_EMAIL=
ATS_PASSWORD=
# per-site override: WORKDAY_PW_<TENANT>=...  (tenant = first label of the host)
RUNNER_AUTO_RESET_PASSWORD=0

# --- Gmail (optional, read-only) for emailed security codes / Workday verification ---
GMAIL_TOKEN_FILE=secrets/gmail_token.json
